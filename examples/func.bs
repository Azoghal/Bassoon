define fancyFunc(a of int, b of double) gives int as {
  bool condition;
  condition = b > 0.5;
  if (condition) {
  	return fancyFunc(a);
  }
  else{
    # this is a comment
    while (not condition){
      b = b - 0.1;
      a = a - 1;
      condition = b > 0.5;
    }
    for (int i = 1; i < 12; a=a+1;){
        a = a - i*b; # implicit cast
    }
    return a;
  }
  return -1;
}
